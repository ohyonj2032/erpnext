+    def test_concurrent_stock_reservation(self):
+        """测试并发库存预留 - 竞态条件测试"""
+        threads = []
+        num_threads = 5
+        expected_failures = 0
+        
+        def reserve_stock(thread_id):
+            """模拟库存预留操作"""
+            try:
+                frappe.connect()  # 每个线程需要独立连接
+                
+                # 创建销售订单并预留库存
+                so = make_sales_order(
+                    item_code=self.item_code,
+                    warehouse=self.warehouse,
+                    qty=25,
+                    do_not_submit=True
+                )
+                so.submit()
+                
+                # 尝试创建库存预留
+                from erpnext.stock.doctype.stock_reservation_entry.stock_reservation_entry import (
+                    make_stock_reservation_entry
+                )
+                
+                try:
+                    sre = make_stock_reservation_entry(
+                        voucher_type="Sales Order",
+                        voucher_no=so.name,
+                        item_code=self.item_code,
+                        warehouse=self.warehouse,
+                        reserved_qty=25,
+                        voucher_qty=25,
+                    )
+                    sre.submit()
+                    self.results_queue.put(("success", thread_id, so.name))
+                except frappe.ValidationError as e:
+                    self.results_queue.put(("validation_error", thread_id, str(e)))
+                except Exception as e:
+                    self.results_queue.put(("error", thread_id, str(e)))
+                finally:
+                    frappe.db.commit()
+            
+            except Exception as e:
+                self.results_queue.put(("fatal_error", thread_id, str(e)))
+            finally:
+                frappe.destroy()
+        
+        # 启动并发线程
+        for i in range(num_threads):
+            t = threading.Thread(target=reserve_stock, args=(i,))
+            threads.append(t)
+            t.start()
+        
+        # 等待所有线程完成
+        for t in threads:
+            t.join()
+        
+        # 分析结果
+        success_count = 0
+        validation_error_count = 0
+        other_errors = 0
+        
+        while not self.results_queue.empty():
+            status, thread_id, message = self.results_queue.get()
+            if status == "success":
+                success_count += 1
+            elif status == "validation_error":
+                validation_error_count += 1
+            else:
+                other_errors += 1
+        
+        # 验证结果 - 库存只有100，5个线程各要25，应该只有4个成功
+        bin = get_bin(self.item_code, self.warehouse)
+        bin.load_from_db()
+        
+        self.assertEqual(
+            success_count + validation_error_count,
+            num_threads,
+            "所有线程要么成功要么应该抛出验证错误"
+        )
+        
+        # 总预留数量不应超过可用库存
