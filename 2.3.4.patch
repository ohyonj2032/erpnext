+import frappe
+
+
+def retry_pending_compensations():
+    """
+    定时任务：每 5 分钟重试待处理的补偿队列。
+
+    注册在 hooks.py scheduler_events 中:
+        scheduler_events = {
+            "cron": {
+                "*/5 * * * *": [
+                    "erpnext.selling.tasks.retry_compensations.retry_pending_compensations"
+                ]
+            }
+        }
+    """
+    pending = frappe.get_all(
+        "Compensation Queue",
+        filters={
+            "status": "Pending",
+            "retry_count": ["<", 5],
+        },
+        limit=50,
+        order_by="creation ASC",
+    )
+
+    succeeded = 0
+    failed = 0
+
+    for entry in pending:
+        try:
+            doc = frappe.get_doc("Compensation Queue", entry.name)
+            doc.execute_compensation()
+            frappe.db.commit()
+            succeeded += 1
+        except Exception:
+            frappe.db.rollback()
+            failed += 1
+            frappe.log_error(
+                title="Compensation Retry Failed",
+                message="Compensation Queue: {}\n{}".format(
+                    entry.name, frappe.get_traceback()
+                ),
+            )
+
+    if succeeded or failed:
+        frappe.log_error(
+            title="Compensation Retry Summary",
+            message="Succeeded: {}, Failed: {}".format(succeeded, failed),
+        )
