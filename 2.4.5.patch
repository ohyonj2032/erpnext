+	def _calculate_queue_position(self):
+		waiting_count = frappe.db.count(
+			"Appointment",
+			filters={
+				"queue_status": "Waiting",
+				"scheduled_time": ("lte", self.scheduled_time),
+			},
+		)
+		return waiting_count + 1
+
+	def _enqueue_appointment(self):
