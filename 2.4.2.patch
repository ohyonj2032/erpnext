+@frappe.whitelist()
+def run_reservation_queue_action(
+	sales_order: str,
+	action: str,
+	items_details: str | list[dict] | None = None,
+	notify: bool = True,
+	reason: str | None = None,
+):
+	doc = frappe.get_doc("Sales Order", sales_order)
+	return doc.run_reservation_queue_action(
+		action=action,
+		items_details=items_details,
+		notify=notify,
+		reason=reason,
+	)
+
+
+def get_reservation_timeout_hours() -> float:
+	stock_settings_meta = frappe.get_meta("Stock Settings")
+	if stock_settings_meta.has_field("reservation_timeout_hours"):
+		return flt(frappe.get_single_value("Stock Settings", "reservation_timeout_hours"))
+	if stock_settings_meta.has_field("reservation_timeout_days"):
+		return flt(frappe.get_single_value("Stock Settings", "reservation_timeout_days")) * 24
+
+	return 0
+
+
+def get_reservation_queue_expiry(sales_order: SalesOrder):
+	sales_order_meta = frappe.get_meta("Sales Order")
+	if sales_order_meta.has_field("reservation_expires_on") and sales_order.get("reservation_expires_on"):
+		return get_datetime(sales_order.get("reservation_expires_on"))
+
+	sales_order_item_meta = frappe.get_meta("Sales Order Item")
+	if sales_order_item_meta.has_field("reservation_expires_on"):
+		expiry_candidates = [
+			get_datetime(item.reservation_expires_on)
+			for item in sales_order.items
+			if item.get("reservation_expires_on")
+		]
+		if expiry_candidates:
+			return min(expiry_candidates)
+
+	timeout_hours = get_reservation_timeout_hours()
+	if timeout_hours <= 0:
+		return None
+
+	return add_to_date(sales_order.creation, hours=timeout_hours, as_datetime=True)
+
+
+def release_expired_stock_reservations() -> None:
+	if not frappe.get_single_value("Stock Settings", "enable_stock_reservation"):
+		return
+
+	has_order_expiry = frappe.get_meta("Sales Order").has_field("reservation_expires_on")
+	has_item_expiry = frappe.get_meta("Sales Order Item").has_field("reservation_expires_on")
+	if not get_reservation_timeout_hours() and not has_order_expiry and not has_item_expiry:
+		return
+
+	sales_orders = frappe.get_all(
+		"Sales Order",
+		filters={
+			"docstatus": 1,
+			"reserve_stock": 1,
+			"status": ["not in", ["Closed", "Completed", "Cancelled"]],
+		},
+		pluck="name",
+	)
+	now = now_datetime()
+	for sales_order in sales_orders:
+		doc = frappe.get_doc("Sales Order", sales_order)
+		expires_on = get_reservation_queue_expiry(doc)
+		if expires_on and expires_on <= now and has_reserved_stock("Sales Order", doc.name):
+			doc.run_reservation_queue_action(
+				"timeout_release",
+				notify=False,
+				reason=_("Reservation timed out"),
+			)
+			frappe.db.commit()
+
