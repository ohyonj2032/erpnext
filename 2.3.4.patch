+++ b/erpnext/selling/services/sales_order_orchestrator.py
@@ -0,0 +1,104 @@
+import frappe
+from frappe import _
+
+from erpnext.selling.services.saga import Saga, SagaExecutionError
+
+
+class SalesOrderSubmissionOrchestrator:
+    """
+    Sales Order 提交的唯一编排入口。
+
+    设计原则:
+    1. 有序执行各步骤
+    2. 每一步成功后通过 Saga 注册补偿函数
+    3. 任何步骤失败 -> 逆序执行已注册的补偿
+    4. 通知类操作在事务成功后再触发（异步 enqueue）
+
+    为什么不由 sales_order.py 直接调用多个子模块:
+    - sales_order.py 属于 selling 限界上下文，不应直接依赖 stock/accounts 模块
+    - 直接在 on_submit 中调用无法统一管理补偿逻辑
+    - 每次新增联动逻辑都需修改 sales_order.py，违反开闭原则
+
+    为什么不由 hooks.py 事件驱动:
+    - hooks.py 事件无序，无法保证执行顺序
+    - hooks.py 没有事务边界，无法统一回滚
+    - hooks.py 不适合传递中间结果（如预留 name 传给会计模块）
+    """
+
+    def __init__(self, sales_order_name):
+        self.so_name = sales_order_name
+        self.so_doc = None
+        self.results = {}
+
+    def execute(self):
+        self.so_doc = frappe.get_doc("Sales Order", self.so_name)
+
+        saga = Saga(
+            reference_doctype="Sales Order",
+            reference_name=self.so_name,
+        )
+
+        saga.add_step(
+            action=self._reserve_stock,
+            compensation=self._compensate_stock_reservation,
+            description="库存预留 (Stock Reservation)",
+        )
+
+        saga.add_step(
+            action=self._create_gl_entries,
+            compensation=self._compensate_gl_entries,
+            description="会计入账 (GL Entries)",
+        )
+
+        saga.add_step(
+            action=self._create_payment_entries,
+            compensation=self._compensate_payment_entries,
+            description="付款入账 (Payment Entries)",
+        )
+
+        saga.add_step(
+            action=self._finalize_sales_order,
+            compensation=self._rollback_so_status,
+            description="更新 Sales Order 状态",
+        )
+
+        try:
+            saga.execute()
+        except SagaExecutionError as e:
+            frappe.throw(
+                _("Sales Order {0} submission failed at step '{1}': {2}")
+                .format(self.so_name, e.step_index, str(e.original_error))
+            )
+
+        self._enqueue_async_notifications()
+
+        return self.results
+
+    def _reserve_stock(self):
+        from erpnext.stock.services.stock_reservation_service import \
+            StockReservationService
+        result = StockReservationService.reserve_items_from_sales_order(self.so_doc)
+        self.results["reservation"] = result
+        return result
+
+    def _compensate_stock_reservation(self, reservation_result):
+        from erpnext.stock.services.stock_reservation_service import \
+            StockReservationService
+        for name in reservation_result.get("reservation_names", []):
+            StockReservationService.cancel_reservation(name)
+
+    def _create_gl_entries(self):
+        from erpnext.accounts.services.sales_order_accounting_service import \
+            SalesOrderAccountingService
+        result = SalesOrderAccountingService.create_gl_entries_for_sales_order(
+            self.so_doc
+        )
+        self.results["gl"] = result
+        return result
+
+    def _compensate_gl_entries(self, gl_result):
+        from erpnext.accounts.services.sales_order_accounting_service import \
+            SalesOrderAccountingService
+        SalesOrderAccountingService.reverse_gl_entries(
+            gl_result.get("gl_entry_names", [])
+        )
+
+    def _create_payment_entries(self):
+        return {"payment_entry_names": []}
+
+    def _compensate_payment_entries(self, payment_result):
+        from erpnext.accounts.services.sales_order_accounting_service import \
+            SalesOrderAccountingService
+        for name in payment_result.get("payment_entry_names", []):
+            SalesOrderAccountingService.cancel_payment_entry(name)
+
+    def _finalize_sales_order(self):
+        self.so_doc.db_set("status", "To Deliver and Bill")
+        if self.results.get("reservation", {}).get("reservation_names"):
+            self.so_doc.db_set("reservation_status", "Reserved")
+        return {"status": "finalized"}
+
+    def _rollback_so_status(self, _result):
+        self.so_doc.db_set("status", "Draft")
+        self.so_doc.db_set("reservation_status", None)
+
+    def _enqueue_async_notifications(self):
+        frappe.enqueue(
+            method=(
+                "erpnext.selling.events.sales_order_submitted."
+                "_send_notifications"
+            ),
+            queue="long",
+            timeout=300,
+            so_name=self.so_name,
+            customer=self.so_doc.customer,
+            results=self.results,
+        )
