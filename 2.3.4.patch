+import frappe
+from frappe.model.document import Document
+
+
+class CompensationQueue(Document):
+    def before_insert(self):
+        if not self.retry_count:
+            self.retry_count = 0
+        if not self.max_retries:
+            self.max_retries = 5
+
+    def execute_compensation(self):
+        if self.status == "Completed":
+            return
+
+        compensation_registry = {
+            "stock_reservation_cancel": self._compensate_stock_reservation,
+            "gl_entry_reversal": self._compensate_gl_entry,
+            "payment_entry_cancel": self._compensate_payment_entry,
+        }
+
+        handler = compensation_registry.get(self.compensation_type)
+        if not handler:
+            self.db_set("status", "Failed")
+            self.db_set("last_error",
+                        "Unknown compensation type: {}".format(self.compensation_type))
+            return
+
+        try:
+            self.db_set("status", "In Progress")
+            handler()
+            self.db_set("status", "Completed")
+        except Exception:
+            self.db_set("retry_count", self.retry_count + 1)
+            self.db_set("last_error", str(frappe.get_traceback())[:500])
+            self.db_set("traceback", frappe.get_traceback())
+            if self.retry_count >= self.max_retries:
+                self.db_set("status", "Failed")
+                self._notify_admin()
+            else:
+                self.db_set("status", "Pending")
+
+    def _compensate_stock_reservation(self):
+        from erpnext.stock.services.stock_reservation_service import \
+            StockReservationService
+        StockReservationService.cancel_reservation(self.compensation_ref)
+
+    def _compensate_gl_entry(self):
+        from erpnext.accounts.services.sales_order_accounting_service import \
+            SalesOrderAccountingService
+        SalesOrderAccountingService.reverse_gl_entries([self.compensation_ref])
+
+    def _compensate_payment_entry(self):
+        from erpnext.accounts.services.sales_order_accounting_service import \
+            SalesOrderAccountingService
+        SalesOrderAccountingService.cancel_payment_entry(self.compensation_ref)
+
+    def _notify_admin(self):
+        try:
+            admin = frappe.db.get_single_value("System Settings", "admin_email") \
+                or frappe.session.user
+            frappe.sendmail(
+                recipients=[admin],
+                subject="Compensation Failed After Max Retries",
+                message=(
+                    "Compensation Queue entry {0} has failed after {1} retries.\n\n"
+                    "Reference: {2} {3}\n"
+                    "Last Error: {4}"
+                ).format(self.name, self.max_retries,
+                         self.reference_doctype, self.reference_name, self.last_error),
+            )
+        except Exception:
+            frappe.log_error(title="Compensation Admin Notification Failed",
+                             message=frappe.get_traceback())
