-+        # Define valid state transitions
-+        valid_transitions = {
-+            "Draft": ["On Hold", "To Deliver and Bill", "To Bill", "To Deliver", "Completed", "Cancelled"],
-+            "On Hold": ["To Deliver and Bill", "To Bill", "To Deliver", "Completed", "Cancelled", "Draft"],
