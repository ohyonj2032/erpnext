+import frappe
+from frappe import _
+
+
+def create_notification_log(doc, method=None):
+    """
+    创建系统通知日志 —— 由 hooks.py 的 doc_events 异步触发。
+    """
+    try:
+        frappe.get_doc({
+            "doctype": "Notification Log",
+            "subject": _("Sales Order {0} submitted").format(doc.name),
+            "for_user": _get_sales_manager(doc),
+            "type": "Alert",
+            "document_type": "Sales Order",
+            "document_name": doc.name,
+        }).insert(ignore_permissions=True)
+    except Exception:
+        frappe.log_error(
+            title="Notification Log Creation Failed",
+            message=frappe.get_traceback(),
+        )
+
+
+def _get_sales_manager(doc):
+    try:
+        if doc.owner:
+            return doc.owner
+        sales_person = frappe.db.get_value(
+            "Sales Team",
+            {"parent": doc.name, "parenttype": "Sales Order"},
+            "sales_person",
+        )
+        return sales_person or doc.owner
+    except Exception:
+        return frappe.session.user
