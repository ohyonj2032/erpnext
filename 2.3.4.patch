+import frappe
+from frappe import _
+
+from erpnext.selling.services.saga import Saga, SagaExecutionError
+
+
+class SalesOrderCancelOrchestrator:
+    """
+    Sales Order 取消的编排入口。
+
+    取消流程是提交流程的反向操作：
+    1. 冲销 GL 分录
+    2. 取消库存预留
+    3. 更新 SO 状态为 Cancelled
+    """
+
+    def __init__(self, sales_order_name):
+        self.so_name = sales_order_name
+        self.so_doc = None
+        self.results = {}
+
+    def execute(self):
+        self.so_doc = frappe.get_doc("Sales Order", self.so_name)
+
+        saga = Saga(
+            reference_doctype="Sales Order",
+            reference_name=self.so_name,
+        )
+
+        saga.add_step(
+            action=self._reverse_gl_entries,
+            compensation=self._recreate_gl_entries,
+            description="冲销 GL 分录",
+        )
+
+        saga.add_step(
+            action=self._cancel_stock_reservations,
+            compensation=self._recreate_stock_reservations,
+            description="取消库存预留",
+        )
+
+        saga.add_step(
+            action=self._finalize_cancellation,
+            compensation=self._restore_so_status,
+            description="更新状态为 Cancelled",
+        )
+
+        try:
+            saga.execute()
+        except SagaExecutionError as e:
+            frappe.throw(
+                _("Sales Order {0} cancellation failed at step '{1}': {2}")
+                .format(self.so_name, e.step_index, str(e.original_error))
+            )
+
+        return self.results
+
+    def _reverse_gl_entries(self):
+        from erpnext.accounts.services.sales_order_accounting_service import \
+            SalesOrderAccountingService
+        gl_entries = frappe.get_all(
+            "GL Entry",
+            filters={"voucher_type": "Sales Order", "voucher_no": self.so_name},
+            pluck="name",
+        )
+        if gl_entries:
+            SalesOrderAccountingService.reverse_gl_entries(gl_entries)
+        return {"gl_entry_names": gl_entries}
+
+    def _recreate_gl_entries(self, gl_result):
+        pass
+
+    def _cancel_stock_reservations(self):
+        from erpnext.stock.services.stock_reservation_service import \
+            StockReservationService
+        reservations = frappe.get_all(
+            "Stock Reservation Entry",
+            filters={"voucher_type": "Sales Order", "voucher_no": self.so_name,
+                     "docstatus": 1},
+            pluck="name",
+        )
+        for name in reservations:
+            StockReservationService.cancel_reservation(name)
+        return {"reservation_names": reservations}
+
+    def _recreate_stock_reservations(self, reservation_result):
+        pass
+
+    def _finalize_cancellation(self):
+        self.so_doc.db_set("status", "Cancelled")
+        self.so_doc.db_set("reservation_status", None)
+        return {"status": "cancelled"}
+
+    def _restore_so_status(self, _result):
+        self.so_doc.db_set("status", "To Deliver and Bill")
+        self.so_doc.db_set("reservation_status", "Reserved")
