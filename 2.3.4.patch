@@ -0,0 +1,111 @@
+import frappe
+from frappe import _
+from frappe.utils import flt, now_datetime
+
+
+class InsufficientStockError(frappe.ValidationError):
+    pass
+
+
+class StockReservationService:
+    """
+    库存预留领域服务 —— 只负责 stock 模块内部的逻辑。
+
+    不负责：会计入账、通知发送、事务管理。
+    这些职责由 orchestrator 层处理。
+    """
+
+    @staticmethod
+    def reserve_items_from_sales_order(so_doc):
+        """
+        根据 Sales Order 明细行检查库存并创建 Stock Reservation Entry。
+
+        Args:
+            so_doc: Sales Order Document 对象
+
+        Returns:
+            dict: {
+                "reservation_names": ["SRE-00001", ...],
+                "reserved_qty": {"item_code": qty, ...}
+            }
+
+        Raises:
+            InsufficientStockError: 库存不足时抛出，由 orchestrator 处理补偿
+        """
+        reservation_names = []
+        reserved_qty = {}
+
+        for item in so_doc.items:
+            if flt(item.qty) <= flt(item.delivered_qty):
+                continue
+
+            reserve_qty = flt(item.qty) - flt(item.delivered_qty)
+            warehouse = item.warehouse or so_doc.set_warehouse
+
+            if not warehouse:
+                continue
+
+            available = StockReservationService._get_available_qty(
+                item.item_code, warehouse
+            )
+
+            if available < reserve_qty:
+                raise InsufficientStockError(
+                    _("Insufficient stock for item {0} in warehouse {1}. "
+                      "Available: {2}, Required: {3}").format(
+                        item.item_code, warehouse, available, reserve_qty
+                    )
+                )
+
+            reservation = frappe.get_doc({
+                "doctype": "Stock Reservation Entry",
+                "item_code": item.item_code,
+                "warehouse": warehouse,
+                "reserved_qty": reserve_qty,
+                "voucher_type": "Sales Order",
+                "voucher_no": so_doc.name,
+                "voucher_detail_no": item.name,
+                "reservation_based_on": "Sales Order",
+                "posting_date": so_doc.transaction_date,
+                "posting_time": now_datetime().strftime("%H:%M:%S"),
+            })
+            reservation.insert()
+            reservation_names.append(reservation.name)
+            reserved_qty[item.item_code] = \
+                reserved_qty.get(item.item_code, 0) + reserve_qty
+
+        return {
+            "reservation_names": reservation_names,
+            "reserved_qty": reserved_qty,
+        }
+
+    @staticmethod
+    def cancel_reservation(reservation_name):
+        """
+        取消单个库存预留 —— 补偿操作。
+
+        使用 cancel() 而不是 delete()，保留审计轨迹。
+        """
+        if not frappe.db.exists("Stock Reservation Entry", reservation_name):
+            frappe.log_error(
+                title="Compensation: Reservation Not Found",
+                message="Reservation {} does not exist, skipping.".format(
+                    reservation_name
+                ),
+            )
+            return
+
+        doc = frappe.get_doc("Stock Reservation Entry", reservation_name)
+        if doc.docstatus == 1:
+            doc.cancel()
+
+    @staticmethod
+    def _get_available_qty(item_code, warehouse):
+        from erpnext.stock.utils import get_stock_balance
+        return flt(get_stock_balance(item_code, warehouse))
