+
+			if queue_settings.enable_auto_convert_to_order:
+				_delayed_order_creation(self.name, queue_settings.order_creation_delay_minutes)
+
+			frappe.db.commit()
+
+		except Exception:
+			frappe.db.rollback()
+			frappe.throw(_("Failed to confirm appointment"))
+
