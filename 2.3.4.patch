index 0000000000..0000000008
--- /dev/null
+++ b/erpnext/selling/services/saga.py
@@ -0,0 +1,70 @@
+import frappe
+
+
+class SagaExecutionError(Exception):
+    def __init__(self, message, step_index=None, original_error=None):
+        self.step_index = step_index
+        self.original_error = original_error
+        super().__init__(message)
+
+
+class Saga:
+    """
+    Saga 编排器 —— 管理跨模块业务流程的逐步执行与补偿。
+
+    使用方式:
+        saga = Saga()
+        saga.add_step(
+            action=lambda: stock_service.reserve(...),
+            compensation=lambda: stock_service.cancel_reservation(...),
+            description="库存预留"
+        )
+        saga.add_step(
+            action=lambda: account_service.create_gl(...),
+            compensation=lambda: account_service.reverse_gl(...),
+            description="会计入账"
+        )
+        saga.execute()
+    """
+
+    def __init__(self, reference_doctype=None, reference_name=None):
+        self.reference_doctype = reference_doctype
+        self.reference_name = reference_name
+        self.steps = []
+        self.executed_steps = []
+
+    def add_step(self, action, compensation, description=""):
+        self.steps.append({
+            "action": action,
+            "compensation": compensation,
+            "description": description,
+        })
+        return self
+
+    def execute(self):
+        for i, step in enumerate(self.steps):
+            try:
+                result = step["action"]()
+                self.executed_steps.append({
+                    "index": i,
+                    "description": step["description"],
+                    "result": result,
+                    "compensation": step["compensation"],
+                })
+            except Exception as e:
+                self._compensate()
+                raise SagaExecutionError(
+                    "Saga step {} '{}' failed: {}".format(
+                        i, step["description"], str(e)
+                    ),
+                    step_index=i,
+                    original_error=e,
+                )
+
+    def _compensate(self):
+        for step in reversed(self.executed_steps):
+            try:
+                step["compensation"](step.get("result"))
+            except Exception:
+                frappe.log_error(
+                    title="Saga Compensation Failed",
+                    message=(
+                        "Step: {} {}\n{}"
+                    ).format(step["index"], step["description"],
+                             frappe.get_traceback()),
+                )
+                self._enqueue_compensation_retry(step)
+
+    def _enqueue_compensation_retry(self, step):
+        try:
+            frappe.get_doc({
+                "doctype": "Compensation Queue",
+                "reference_doctype": self.reference_doctype or "",
+                "reference_name": self.reference_name or "",
+                "compensation_type": "stock_reservation_cancel",
+                "compensation_ref": str(step.get("result", "")),
+                "status": "Pending",
+                "retry_count": 0,
+                "max_retries": 5,
+            }).insert(ignore_permissions=True)
+        except Exception:
+            frappe.log_error(
+                title="Failed to Enqueue Compensation Retry",
+                message=frappe.get_traceback(),
+            )
diff --git a/erpnext/selling/services/sales_order_orchestrator.py b/erpnext/selling/services/sales_order_orchestrator.py
