+import frappe
+from frappe import _
+
+
+class SalesOrderAccountingService:
+    """
+    销售订单会计领域服务 —— 只负责 accounts 模块内部的逻辑。
+
+    不负责：库存预留、通知发送、事务管理。
+    这些职责由 orchestrator 层处理。
+    """
+
+    @staticmethod
+    def create_gl_entries_for_sales_order(so_doc):
+        """
+        为 Sales Order 创建总账分录。
+
+        Returns:
+            dict: {"gl_entry_names": ["GL-00001", ...]}
+        """
+        from erpnext.accounts.general_ledger import make_gl_entries
+        from erpnext.accounts.party import get_party_account
+
+        gl_entries = []
+
+        gl_entries.append(so_doc.get_gl_dict({
+            "account": get_party_account(so_doc.customer),
+            "against": so_doc.name,
+            "debit": so_doc.total,
+            "credit": 0.0,
+            "debit_in_account_currency": so_doc.total,
+            "remarks": _("Against Sales Order: {0}").format(so_doc.name),
+        }))
+
+        gl_entries.append(so_doc.get_gl_dict({
+            "account": so_doc.debit_to,
+            "against": so_doc.customer,
+            "debit": 0.0,
+            "credit": so_doc.total,
+            "credit_in_account_currency": so_doc.total,
+            "remarks": _("Against Sales Order: {0}").format(so_doc.name),
+        }))
+
+        make_gl_entries(gl_entries, cancel=False, merge_entries=False)
+
+        return {
+            "gl_entry_names": [g.name for g in gl_entries if g.name],
+        }
+
+    @staticmethod
+    def reverse_gl_entries(gl_entry_names):
+        """
+        冲销 GL 分录 —— 补偿操作。
+        """
+        from erpnext.accounts.general_ledger import make_reverse_gl_entry
+        for name in gl_entry_names:
+            if frappe.db.exists("GL Entry", name):
+                make_reverse_gl_entry(
+                    voucher_type="Sales Order",
+                    voucher_no=name,
+                )
+
+    @staticmethod
+    def cancel_payment_entry(payment_entry_name):
+        if frappe.db.exists("Payment Entry", payment_entry_name):
+            doc = frappe.get_doc("Payment Entry", payment_entry_name)
+            if doc.docstatus == 1:
+                doc.cancel()
