+import frappe
+from frappe import _
+
+
+def send_async_notifications(doc, method=None):
+    """
+    异步通知入口 —— 由 hooks.py 的 doc_events 触发。
+
+    注意：这是异步非关键路径，失败不影响 Sales Order 提交结果。
+    """
+    frappe.enqueue(
+        method=(
+            "erpnext.selling.events.sales_order_submitted."
+            "_send_notifications"
+        ),
+        queue="long",
+        timeout=300,
+        so_name=doc.name,
+        customer=doc.customer,
+        results={},
+    )
+
+
+def _send_notifications(so_name, customer, results=None):
+    """
+    后台任务中执行的具体通知逻辑。
+
+    每个通知独立 try/except，一个失败不影响其他。
+    """
+    _send_email_to_customer(so_name, customer)
+    _notify_sales_team(so_name)
+    _trigger_webhooks(so_name)
+    _create_notification_log(so_name)
+
+
+def _send_email_to_customer(so_name, customer):
+    try:
+        so_doc = frappe.get_doc("Sales Order", so_name)
+        if not customer:
+            return
+        customer_email = frappe.db.get_value("Customer", customer, "email_id")
+        if not customer_email:
+            return
+        frappe.sendmail(
+            recipients=[customer_email],
+            subject=_("Sales Order {0} Confirmed").format(so_name),
+            message=_("Your Sales Order {0} has been confirmed.").format(so_name),
+        )
+    except Exception:
+        frappe.log_error(
+            title="Customer Email Notification Failed",
+            message=frappe.get_traceback(),
+        )
+
+
+def _notify_sales_team(so_name):
+    try:
+        frappe.get_doc({
+            "doctype": "Notification Log",
+            "subject": _("Sales Order {0} submitted").format(so_name),
+            "for_user": frappe.session.user,
+            "type": "Alert",
+            "document_type": "Sales Order",
+            "document_name": so_name,
+        }).insert(ignore_permissions=True)
+    except Exception:
+        frappe.log_error(
+            title="Sales Team Notification Failed",
+            message=frappe.get_traceback(),
+        )
+
+
+def _trigger_webhooks(so_name):
+    try:
+        frappe.get_doc("Sales Order", so_name).run_method("run_webhooks")
+    except Exception:
+        frappe.log_error(
+            title="Webhook Trigger Failed",
+            message=frappe.get_traceback(),
+        )
+
+
+def _create_notification_log(so_name):
+    pass
