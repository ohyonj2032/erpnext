+	def run_reservation_queue_action(
+		self,
+		action: str,
+		items_details: str | list[dict] | None = None,
+		notify: bool = True,
+		reason: str | None = None,
+	):
+		action = cstr(action).strip().lower()
+		self.validate_reservation_queue_action(action)
+
+		if isinstance(items_details, str):
+			items_details = parse_json(items_details)
+
+		context = frappe._dict(
+			{
+				"action": action,
+				"items_details": items_details,
+				"notify": bool(cint(notify)),
+				"reason": reason,
+			}
+		)
+		snapshot_before = self.get_reservation_queue_snapshot()
+
+		for handler in self.get_reservation_queue_handlers(action):
+			handler(context)
+
+		self.update_reserved_qty()
+		snapshot_after = self.get_reservation_queue_snapshot()
+		self.log_reservation_queue_action(context, snapshot_before, snapshot_after)
+		return snapshot_after
