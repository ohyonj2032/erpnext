+	def validate_reservation_queue_action(self, action: str) -> None:
+		handlers = self.get_reservation_queue_handlers(action)
+		if not handlers:
+			frappe.throw(_("Unsupported reservation queue action {0}.").format(frappe.bold(action)))
+
+		if action in {"submit", "cancel"}:
+			return
+
+		if self.docstatus != 1:
+			frappe.throw(_("Reservation queue actions are only allowed on submitted Sales Orders."))
+
+	def get_reservation_queue_handlers(self, action: str) -> list:
+		action_map = {
+			"submit": [self._reserve_stock_for_queue],
+			"cancel": [self._release_queue_reservations],
+			"manual_cancel": [self._release_queue_reservations],
+			"timeout_release": [self._release_queue_reservations],
+			"manual_reschedule": [self._rebuild_queue_reservations],
+		}
+		handlers = list(action_map.get(action, []))
+		hooks = frappe.get_hooks("sales_order_reservation_queue_handlers") or {}
+		if isinstance(hooks, dict):
+			hook_methods = hooks.get(action, []) or []
+			if isinstance(hook_methods, str):
+				hook_methods = [hook_methods]
+			for method_path in hook_methods:
+				handlers.append(frappe.get_attr(method_path))
+
+		return handlers
+
+	def _reserve_stock_for_queue(self, context: frappe._dict) -> None:
+		if self.get("reserve_stock") and not self.get("is_subcontracted"):
+			self.create_stock_reservation_entries(
+				items_details=context.items_details,
+				notify=context.notify,
+			)
+
+	def _release_queue_reservations(self, context: frappe._dict) -> None:
+		self.cancel_stock_reservation_entries(notify=context.notify)
+
+	def _rebuild_queue_reservations(self, context: frappe._dict) -> None:
+		self.cancel_stock_reservation_entries(notify=False)
+		self._reserve_stock_for_queue(context)
+
+	def get_reservation_queue_snapshot(self) -> list[frappe._dict]:
+		if not self.name:
+			return []
+
+		reserved_qty_details = get_sre_reserved_qty_details_for_voucher("Sales Order", self.name)
+		snapshot = []
+		for item in self.items:
+			if not item.get("reserve_stock"):
+				continue
+
+			reserved_qty = flt(reserved_qty_details.get(item.name, 0))
+			unreserved_qty = max(flt(get_unreserved_qty(item, reserved_qty_details)), 0)
+			status = "Reserved"
+			if reserved_qty <= 0:
+				status = "Queued"
+			elif unreserved_qty > 0:
+				status = "Partially Reserved"
+
+			snapshot.append(
+				frappe._dict(
+					{
+						"sales_order_item": item.name,
+						"item_code": item.item_code,
+						"warehouse": item.warehouse,
+						"qty": flt(item.stock_qty),
+						"reserved_qty": reserved_qty,
+						"unreserved_qty": unreserved_qty,
+						"status": status,
+					}
+				)
+			)
+
+		return snapshot
+
+	def get_reservation_queue_summary(self, snapshot: list[frappe._dict]) -> frappe._dict:
+		summary = frappe._dict(
+			{
+				"queued_rows": 0,
+				"partial_rows": 0,
+				"reserved_rows": 0,
+				"reserved_qty": 0.0,
+				"unreserved_qty": 0.0,
+			}
+		)
+		for row in snapshot:
+			summary.reserved_qty += flt(row.reserved_qty)
+			summary.unreserved_qty += flt(row.unreserved_qty)
+			if row.status == "Queued":
+				summary.queued_rows += 1
+			elif row.status == "Partially Reserved":
+				summary.partial_rows += 1
+			else:
+				summary.reserved_rows += 1
+
+		return summary
+
+	def log_reservation_queue_action(
+		self,
+		context: frappe._dict,
+		snapshot_before: list[frappe._dict],
+		snapshot_after: list[frappe._dict],
+	) -> None:
+		before = self.get_reservation_queue_summary(snapshot_before)
+		after = self.get_reservation_queue_summary(snapshot_after)
+		if not snapshot_before and not snapshot_after:
+			return
+		if before == after and context.action not in {"submit", "cancel", "manual_cancel", "timeout_release", "manual_reschedule"}:
+			return
+
+		label_map = {
+			"submit": _("Submit"),
+			"cancel": _("Cancel"),
+			"manual_cancel": _("Manual Cancel"),
+			"timeout_release": _("Timeout Release"),
+			"manual_reschedule": _("Manual Reschedule"),
+		}
+		message = _(
+			"Reservation Queue {0}: reserved {1}, queued {2}, partial {3}, open qty {4}"
+		).format(
+			label_map.get(context.action, frappe.unscrub(context.action)),
+			after.reserved_rows,
+			after.queued_rows,
+			after.partial_rows,
+			after.unreserved_qty,
+		)
+		if context.reason:
+			message = _("{0}. Reason: {1}").format(message, context.reason)
+
+		self.add_comment("Info", message)
+
