+        
+        # 创建交货单草稿
+        dn = make_delivery_note(so.name)
+        dn.insert()
+        
+        # 尝试重复提交同一单据
+        def submit_delivery_note(attempt):
+            try:
+                frappe.connect()
+                dn_doc = frappe.get_doc("Delivery Note", dn.name)
+                dn_doc.submit()
+                self.results_queue.put(("success", attempt))
+            except frappe.DocstatusTransitionError as e:
+                self.results_queue.put(("docstatus_error", attempt, str(e)))
+            except Exception as e:
+                self.results_queue.put(("error", attempt, str(e)))
+            finally:
+                frappe.destroy()
+        
+        # 启动多个线程尝试同时提交
+        threads = []
+        for i in range(5):
+            t = threading.Thread(target=submit_delivery_note, args=(i,))
+            threads.append(t)
+            t.start()
+        
+        for t in threads:
+            t.join()
+        
+        # 验证结果 - 只有一个应该成功，其他应该失败
+        success_count = 0
+        docstatus_errors = 0
+        
+        while not self.results_queue.empty():
+            status, attempt, *_ = self.results_queue.get()
+            if status == "success":
+                success_count += 1
+            elif status == "docstatus_error":
+                docstatus_errors += 1
+        
+        self.assertEqual(
