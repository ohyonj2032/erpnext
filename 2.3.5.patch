diff --git a/erpnext/selling/services/sales_order_submission_service.py b/erpnext/selling/services/sales_order_submission_service.py
new file mode 100644
--- /dev/null
+++ b/erpnext/selling/services/sales_order_submission_service.py
@@ -0,0 +1,147 @@
+import frappe
+from frappe import _
+from frappe.utils import cint
+
+
+class SalesOrderSubmissionService:
+	STEP_DEFINITIONS = [
+		{"name": "credit_limit", "method": "_validate_credit_limit", "compensate": None},
+		{"name": "reserved_qty", "method": "_update_reserved_qty", "compensate": "_undo_reserved_qty"},
+		{"name": "prevdoc_status", "method": "_update_prevdoc_status", "compensate": "_undo_prevdoc_status"},
+		{"name": "blanket_order", "method": "_update_blanket_order", "compensate": "_undo_blanket_order"},
+		{"name": "project", "method": "_update_project", "compensate": "_undo_project"},
+		{"name": "inter_company", "method": "_handle_inter_company", "compensate": "_undo_inter_company"},
+		{"name": "stock_reservation", "method": "_reserve_stock", "compensate": "_undo_stock_reservation"},
+	]
+
+	def __init__(self, doc):
+		self.doc = doc
+		self._executed_steps = []
+
+	def execute(self):
+		for step in self.STEP_DEFINITIONS:
+			log = self._create_step_log(step["name"])
+			try:
+				getattr(self, step["method"])()
+				self._complete_step_log(log)
+				self._executed_steps.append(step["name"])
+			except Exception:
+				self._fail_step_log(log)
+				self._compensate_completed_steps(step["name"])
+				raise
+
+	def execute_cancel(self):
+		self._cancel_stock_reservation()
+		self._cancel_reserved_qty()
+		self._cancel_prevdoc_status()
+		self._cancel_blanket_order()
+		self._cancel_project()
+		self._cancel_inter_company()
+
+	def _validate_credit_limit(self):
+		from erpnext.selling.doctype.customer.customer import check_credit_limit
+
+		if not cint(
+			frappe.db.get_value(
+				"Customer Credit Limit",
+				{"parent": self.doc.customer, "parenttype": "Customer", "company": self.doc.company},
+				"bypass_credit_limit_check",
+			)
+		):
+			check_credit_limit(self.doc.customer, self.doc.company)
+
+	def _update_reserved_qty(self):
+		self.doc.update_reserved_qty()
+
+	def _update_prevdoc_status(self):
+		self.doc.update_prevdoc_status("submit")
+
+	def _update_blanket_order(self):
+		self.doc.update_blanket_order()
+
+	def _update_project(self):
+		self.doc.update_project()
+
+	def _handle_inter_company(self):
+		from erpnext.accounts.doctype.sales_invoice.sales_invoice import update_linked_doc
+
+		update_linked_doc(self.doc.doctype, self.doc.name, self.doc.inter_company_order_reference)
+
+	def _reserve_stock(self):
+		if self.doc.get("reserve_stock") and not self.doc.get("is_subcontracted"):
+			self.doc.create_stock_reservation_entries()
+
+	def _cancel_stock_reservation(self):
+		self.doc.cancel_stock_reservation_entries()
+
+	def _cancel_reserved_qty(self):
+		self.doc.update_reserved_qty()
+
+	def _cancel_prevdoc_status(self):
+		self.doc.update_prevdoc_status("cancel")
+
+	def _cancel_blanket_order(self):
+		self.doc.update_blanket_order()
+
+	def _cancel_project(self):
+		self.doc.update_project()
+
+	def _cancel_inter_company(self):
+		from erpnext.accounts.doctype.sales_invoice.sales_invoice import unlink_inter_company_doc
+
+		unlink_inter_company_doc(self.doc.doctype, self.doc.name, self.doc.inter_company_order_reference)
+
+	def _compensate_completed_steps(self, failed_step):
+		for step in reversed(self.STEP_DEFINITIONS):
+			if step["name"] == failed_step:
+				break
+			if step["compensate"]:
+				try:
+					getattr(self, step["compensate"])()
+				except Exception:
+					frappe.log_error(
+						f"Compensation failed for step: {step['name']}",
+						"Sales Order Submission Compensation",
+					)
+
+	def _undo_reserved_qty(self):
+		self.doc.update_reserved_qty()
+
+	def _undo_prevdoc_status(self):
+		self.doc.update_prevdoc_status("cancel")
+
+	def _undo_blanket_order(self):
+		self.doc.update_blanket_order()
+
+	def _undo_project(self):
+		self.doc.update_project()
+
+	def _undo_inter_company(self):
+		from erpnext.accounts.doctype.sales_invoice.sales_invoice import unlink_inter_company_doc
+
+		unlink_inter_company_doc(self.doc.doctype, self.doc.name, self.doc.inter_company_order_reference)
+
+	def _undo_stock_reservation(self):
+		self.doc.cancel_stock_reservation_entries(notify=False)
+
+	def _create_step_log(self, step_name):
+		return frappe.get_doc(
+			{
+				"doctype": "Submission Step Log",
+				"reference_type": self.doc.doctype,
+				"reference_name": self.doc.name,
+				"step_name": step_name,
+				"status": "Pending",
+			}
+		).insert(ignore_permissions=True)
+
+	def _complete_step_log(self, log):
+		log.status = "Completed"
+		log.save(ignore_permissions=True)
+
+	def _fail_step_log(self, log):
+		log.status = "Failed"
+		log.save(ignore_permissions=True)
diff --git a/erpnext/selling/services/credit_limit_service.py b/erpnext/selling/services/credit_limit_service.py
